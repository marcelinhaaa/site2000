<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>💖 Calculadora do Amor 💖</title>
    <style>
        body {
            background-color: #ffd1dc;
            background-image: url('https://i.pinimg.com/originals/7f/39/1e/7f391e2e0e0ad709c8f9a23743fe1d53.gif');
            background-repeat: repeat;
            font-family: "Courier New", Courier, monospace;
            color: #800020;
            text-align: center;
            padding: 20px;
            overflow-x: hidden;
        }

        .rastro-coracao {
            position: absolute;
            font-size: 14px;
            pointer-events: none;
            animation: cair 1s linear forwards;
            z-index: 9999;
        }

        @keyframes cair {
            0% { transform: translateY(0) scale(1); opacity: 1; }
            100% { transform: translateY(30px) scale(0.5); opacity: 0; }
        }

        .container {
            background-color: rgba(255, 255, 255, 0.95);
            border: 4px double #800020;
            max-width: 650px;
            margin: 0 auto;
            padding: 0 0 20px 0;
            box-shadow: 10px 10px 0px #800020;
            position: relative;
            overflow: hidden;
        }

        .banner-topo {
            width: 100%;
            height: auto;
            max-height: 200px;
            object-fit: cover;
            border-bottom: 4px double #800020;
        }

        .conteudo-titulo { padding: 15px 20px 0 20px; }

        h1 {
            color: #800020;
            text-shadow: 2px 2px #ffb6c1;
            font-size: 26px;
            margin: 10px 0 5px 0;
        }

        .Abas-menu {
            display: flex;
            justify-content: center;
            align-items: center;
            flex-wrap: wrap;
            margin: 20px auto;
            gap: 10px;
            max-width: 95%;
            padding: 0 10px;
        }

        .aba-btn {
            background-color: #ffb6c1;
            color: #800020;
            border: 2px solid #800020;
            padding: 8px 0;
            font-weight: bold;
            font-family: "Courier New", Courier, monospace;
            font-size: 12px;
            flex: 1;
            min-width: 100px;
            max-width: 120px;
            text-align: center;
            box-sizing: border-box;
            box-shadow: 2px 2px 0px #800020;
            text-decoration: none;
        }

        .aba-btn.ativa {
            background-color: #800020;
            color: white;
            box-shadow: none;
            transform: translate(2px, 2px);
        }

        .conteudo-guia {
            min-height: 280px;
            padding: 10px 20px;
            box-sizing: border-box;
        }

        input[type="text"] {
            width: 90%;
            padding: 10px;
            margin: 8px 0;
            border: 2px solid #800020;
            background-color: #fff;
            color: #800020;
            font-weight: bold;
            font-family: "Courier New", Courier, monospace;
            font-size: 12px;
            box-sizing: border-box;
        }

        button.acao-btn {
            background-color: #800020;
            color: white;
            border: 2px solid #ffb6c1;
            padding: 10px 20px;
            font-size: 15px;
            cursor: pointer;
            font-weight: bold;
            margin-top: 15px;
            box-shadow: 4px 4px 0px #ffb6c1;
        }

        button.acao-btn:hover {
            background-color: #ffb6c1;
            color: #800020;
        }

        .blink { animation: blinker 1s linear infinite; }
        @keyframes blinker { 50% { opacity: 0; } }

        .caixa-resultado {
            margin-top: 15px;
            font-size: 18px;
            font-weight: bold;
        }

        .gif-final { max-width: 150px; margin-top: 20px; }
    </style>
</head>
<body>

<div class="container">
    <img class="banner-topo" src="https://i.pinimg.com/1200x/22/ad/6a/22ad6ac7a3c6d50cc9d253c8d9a42290.jpg" alt="Banner Romântico Retrô">

    <div class="conteudo-titulo">
        <h1>✨ Amor 2000 ✨</h1>
        <p class="blink" style="color: red; font-weight: bold; margin: 0;">~* Seu ponto romântico na web *~</p>
    </div>

    <div class="Abas-menu">
        <a href="index.html" class="aba-btn">🏠Início</a>
        <a href="calculadora.html" class="aba-btn ativa">💘Calculadora</a>
        <a href="biscoito.html" class="aba-btn">🥠Biscoito</a>
        <a href="correio.html" class="aba-btn">💌Correio</a>
        <a href="quiz.html" class="aba-btn">🔮Quiz</a>
    </div>

    <hr style="border: 1px dashed #800020; margin: 0 20px;">

    <div class="conteudo-guia">
        <h3>🏹 Medidor de Compatibilidade 🏹</h3>
        <label for="nome1">Seu Nome:</label><br>
        <input type="text" id="nome1" placeholder="Ex: Maria"><br>
        <label for="nome2">Nome do crush:</label><br>
        <input type="text" id="nome2" placeholder="Ex: João"><br>
        <button class="acao-btn" onclick="calcularAmor()">Calcular Chance %</button>
        <div id="res-calculadora" class="caixa-resultado"></div>
    </div>

    <hr style="border: 1px dashed #800020; margin: 20px 20px 0 20px;">
    <div>
        <img class="gif-final" src="https://i.pinimg.com/originals/a7/72/5d/a7725dcb15f32be8a0c6011788fd527f.gif" alt="Corações Piscando">
    </div>
</div>

<script>
    document.addEventListener('mousemove', function(e) {
        if (Math.random() > 0.15) return;
        let coracao = document.createElement('span');
        coracao.className = 'rastro-coracao';
        const simbolos = ['💖', '♥', '💋', '✨'];
        coracao.innerText = simbolos[Math.floor(Math.random() * simbolos.length)];
        coracao.style.left = e.pageX + 'px';
        coracao.style.top = e.pageY + 'px';
        document.body.appendChild(coracao);
        setTimeout(() => { coracao.remove(); }, 1000);
    });

    function calcularAmor() {
        let nome1 = document.getElementById('nome1').value.trim();
        let nome2 = document.getElementById('nome2').value.trim();
        if (nome1 === "" || nome2 === "") { alert("Insira os dois nomes!"); return; }

        let combinacao = nome1.toLowerCase() + nome2.toLowerCase();
        let soma = 0;
        for (let i = 0; i < combinacao.length; i++) soma += combinacao.charCodeAt(i);
        let porcentagem = (soma % 61) + 40;

        let msg = porcentagem < 65 ? " Coisas boas vem por ai! Use seu poder para conquistar!" :
                  porcentagem < 85 ? " Rola uma química forte aí, hein! Manda uma indireta." :
                  " DESTINO! O cupido usou hack com vocês dois! 💖";

        document.getElementById('res-calculadora').innerHTML = `
            <p style="font-size: 32px; color: red;" class="blink">${porcentagem}%</p>
            <p>${msg}</p>
        `;
    }
</script>

</body>
</html>
